# Never commit real values. Production values belong in provider secret stores.
APP_ENV=development
SECRET_KEY=replace-with-32-plus-random-characters
JWT_SECRET_KEY=replace-with-a-different-32-plus-random-secret
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=3600

# Preferred in production: Neon pooled PostgreSQL URL including sslmode=require.
DATABASE_URL=
# Local fallback only when DATABASE_URL is empty.
DB_USER=cybersentinel
DB_PASSWORD=replace-local-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cybersentinel
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300

# Comma-separated exact origins. Production must be HTTPS.
FRONTEND_URLS=http://localhost:5173
MAX_REQUEST_BYTES=32768
API_RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
SENTRY_DSN=

VIRUSTOTAL_API_KEY=
VT_CACHE_TTL_SECONDS=900
VT_CACHE_MAX_ENTRIES=1000

BULK_MAX_CSV_BYTES=1048576
BULK_MAX_URLS_PER_JOB=1000
BULK_MAX_ACTIVE_JOBS_PER_USER=2
BULK_MAX_JOBS_PER_DAY=10
BULK_RETENTION_HOURS=24
BULK_WORKER_POLL_SECONDS=2
BULK_ITEM_MAX_RETRIES=2

# Keep disabled in the baseline production deployment unless an isolated ClamAV worker with private quarantine storage is provisioned.
FILE_SCAN_ENABLED=false
FILE_SCAN_MAX_BYTES=10485760
FILE_SCAN_ALLOWED_TYPES=html,text,pdf,png,jpeg,gif
FILE_SCAN_MAX_ACTIVE_PER_USER=2
FILE_SCAN_MAX_DAILY_PER_USER=20
FILE_SCAN_RESULT_RETENTION_HOURS=24
FILE_SCAN_QUARANTINE_DIR=/tmp/cybersentinel-quarantine
FILE_SCAN_WORKER_POLL_SECONDS=2
FILE_SCAN_HTML_MAX_BYTES=2097152
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
FILE_SCAN_STALE_SECONDS=300
FILE_SCAN_MAX_ATTEMPTS=2
BULK_JOB_STALE_SECONDS=900
BULK_CLEANUP_INTERVAL_SECONDS=3600
