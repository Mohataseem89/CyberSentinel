# Copy this file to backend/.env for local development. Never commit the real file.
# Generate unique random values for SECRET_KEY and JWT_SECRET_KEY.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# PostgreSQL connection settings. Do not use production credentials locally.
DB_USER=cybersentinel
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cybersentinel

# Optional: without this key, VirusTotal reputation is reported as unavailable.
VIRUSTOTAL_API_KEY=

# Allowed browser origin for local development.
FRONTEND_URL=http://localhost:5173
