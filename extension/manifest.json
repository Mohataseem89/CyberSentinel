{
  "manifest_version": 3,
  "name": "CyberSentinel URL Risk Checker",
  "version": "3.0.0",
  "description": "Manually check a URL with CyberSentinel before deciding whether to trust it.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "__CYBERSENTINEL_API_ORIGIN__/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}